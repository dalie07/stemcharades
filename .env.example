# Copy to .env for local work. Every value is optional: with none set, the game runs guest-only on port 3000.
# On Render these are set in the service's Environment tab (see render.yaml), never committed.

# --- Server -------------------------------------------------------------------------------------
PORT=3000
# In production only cards marked "reviewed" are served. Set to 1 locally to play the draft cards too.
ALLOW_DRAFT_CARDS=1
# Set to 1 only behind a trusted proxy (Render), so per-IP rate limits see the real client address.
# TRUST_PROXY=1
# Resource caps for the 512 MB free instance.
# MAX_ROOMS=200
# MAX_CONNECTIONS=600

# --- Optional accounts (see docs/setup-accounts.md). All of DATABASE_URL, SESSION_SECRET and at least
# --- one provider are needed; otherwise sign-in is simply switched off.
# DATABASE_URL=postgresql://user:password@host/dbname
# SESSION_SECRET=            # openssl rand -hex 32
# PUBLIC_URL=https://your-service.onrender.com
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# --- Client build -------------------------------------------------------------------------------
# "owner/repo". Turns the "Flag this card" button into a prefilled GitHub issue.
# VITE_GITHUB_REPO=dalie07/stemcharades
