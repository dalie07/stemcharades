{
  "name": "stemcharades",
  "version": "1.0.0",
  "private": true,
  "description": "A multiplayer party game for STEM revision: explain it without saying the forbidden words.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dalie07/stemcharades.git"
  },
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm run start -w server",
    "check": "npm run typecheck && npm run lint && npm run validate:cards && npm test",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p e2e",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage -w server",
    "test:e2e": "playwright test",
    "validate:cards": "tsx scripts/validate-cards.ts",
    "cards:prompts": "tsx scripts/card-prompts.ts",
    "cards:import": "tsx scripts/import-cards.ts",
    "review": "tsx scripts/review.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.49.0",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^9.0.0",
    "drizzle-orm": "^0.45.4",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  }
}
