{
  "name": "@stemcharades/server",
  "version": "0.1.0",
  "private": true,
  "description": "Express and Socket.IO server: rooms, the round engine and optional accounts.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@stemcharades/shared": "*",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.0",
    "pg": "^8.13.0",
    "socket.io": "^4.8.0",
    "tsx": "^4.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.11",
    "socket.io-client": "^4.8.0",
    "vitest": "^5.1.1"
  }
}
